# Local infrastructure only. Copy to .env and replace the password.
POSTGRES_IMAGE=docker.io/library/postgres:18.4-bookworm@sha256:1961f96e6029a02c3812d7cb329a3b03a3ac2bb067058dec17b0f5596aca9296
POSTGRES_DB=medevidence
POSTGRES_USER=medevidence
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.18.3-unprivileged@sha256:affb67e1d6f2f93d7d20b90d238a7d4b974d36351c162e73bda794e4b2e03483
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Explicit local application settings. Secrets are read from the server process.
# Set these in the server process; they are comments to keep the Compose template strict.
# MEDEV_DATABASE_URL=postgresql+psycopg://medevidence:replace-password@127.0.0.1:5432/medevidence
# MEDEV_SNAPSHOT_ROOT=replace-with-absolute-project-local-data-path
# MEDEV_CODE_REVISION=replace-with-current-40-character-git-revision
# MEDEV_QWEN_ENDPOINT=https://replace-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_API_KEY=replace-with-authorized-qwen-key
# DEEPSEEK_API_KEY=replace-with-authorized-generation-key
# Optional approved CADEC assets; configure both or leave both absent.
# MEDEV_CADEC_ARCHIVE=replace-with-absolute-approved-archive-path
# MEDEV_CADEC_MANIFEST=replace-with-absolute-approved-manifest-path
