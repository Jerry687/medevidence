# Local infrastructure only. Copy to .env and replace development values.
# Image versions are intentionally unset until decision gate ME-000A.
POSTGRES_IMAGE=
POSTGRES_DB=medevidence
POSTGRES_USER=medevidence
POSTGRES_PASSWORD=replace-for-local-use
POSTGRES_PORT=5432

QDRANT_IMAGE=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Connector timeout, retry, result-limit, and cache values are intentionally
# unset until the applicable M1A/M1B connector policy is approved.
EXTERNAL_API_CONNECT_TIMEOUT_SECONDS=
EXTERNAL_API_READ_TIMEOUT_SECONDS=
EXTERNAL_API_MAX_RETRIES=
EXTERNAL_API_CACHE_TTL_SECONDS=

# Optional source identification and credentials. Never commit real values.
NCBI_TOOL_NAME=medevidence
NCBI_EMAIL=replace@example.com
NCBI_API_KEY=
OPENFDA_API_KEY=

# Model-provider variables are added only after provider/data-policy approval.
# External tracing vendor variables are added only after its decision gate.
